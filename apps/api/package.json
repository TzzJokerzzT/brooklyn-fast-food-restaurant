{
	"name": "api",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --hot index.ts",
		"build": "bun build index.ts --outdir ./dist",
		"start": "bun run dist/index.js",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"clean": "rm -rf dist node_modules",
		"contract:emit": "prisma-cli contract emit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@prisma/cli": "^8.0.0-rc.9",
		"@prisma/cli-engine": "0.2.0",
		"@types/bcrypt": "^6.0.0",
		"@types/bun": "latest",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.3.0"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@prisma/orm-postgres": "^8.0.0-rc.5",
		"bcrypt": "^6.0.0",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.2",
		"helmet": "^8.3.0",
		"http-status-codes": "^2.3.0",
		"jsonwebtoken": "^9.0.3",
		"valibot": "^1.4.2"
	}
}
