{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 80,
		"lineEnding": "lf"
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"suspicious": {
				"noConsole": "error",
				"useAwait": "error",
				"useErrorMessage": "error",
				"useIsArray": "error"
			},
			"style": {
				"useImportType": "error"
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"useImageSize": "error"
			},
			"a11y": {
				"useButtonType": "error"
			}
		},
		"domains": {
			"next": "recommended",
			"react": "recommended",
			"test": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							["react", "react/**", "react-*", "react-*/**"],
							":BLANK_LINE:",
							["next", "next/**"],
							":BLANK_LINE:",
							["@heroui/*"],
							":BLANK_LINE:",
							["@tanstack/*"],
							":BLANK_LINE:",
							["@/*"]
						]
					}
				}
			}
		}
	}
}
