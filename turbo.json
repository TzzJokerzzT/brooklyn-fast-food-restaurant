{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"cache": false
		},
		"test:watch": {
			"cache": false,
			"persistent": true
		},
		"test:coverage": {
			"cache": false
		},
		"lint:fix": {
			"dependsOn": ["^lint:fix"]
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
